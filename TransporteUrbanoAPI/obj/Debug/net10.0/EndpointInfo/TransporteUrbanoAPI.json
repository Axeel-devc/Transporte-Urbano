  "components": {
    "schemas": {
      "ColectivoSaveDto": {
        "required": [
          "patente"
        ],
        "type": "object",
        "properties": {
          "patente": {
            "minLength": 1,
            "pattern": "^[A-Za-z]{2}\\d{3}[A-Za-z]{2}$",
            "type": "string"
          },
          "marca": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "modelo": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "codigoLinea": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "codigoEstado": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "nombreUsuario",
          "password"
        ],
        "type": "object",
        "properties": {
          "nombreUsuario": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MantenimientoSaveDto": {
        "type": "object",
        "properties": {
          "nroCoche": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "codigoTipoMantenimiento": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "fecha": {
            "type": "string",
            "format": "date"
          },
          "descripcion": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "costo": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegistroDto": {
        "required": [
          "email",
          "nombreUsuario",
          "password"
        ],
        "type": "object",
        "properties": {
          "nombreUsuario": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 100,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Ingresá el JWT (sin la palabra Bearer).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
